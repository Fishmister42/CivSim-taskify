{
  "$defs": {
    "ActionExecution": {
      "additionalProperties": false,
      "description": "The outcome of dispatching one decision's action, and how it was verified.\n\n``outcome`` is derived from the action's declared verification predicate\nand must never be asserted directly by an executor (FR-011) -- this\nmodel cannot enforce *that* on its own (it has no access to the\npredicate evaluator), but it does enforce the one thing it can:\n``rejection_reason`` is present exactly when ``outcome == rejected`` or\n``partially_applied`` is not itself a rejection, so a reason is\nmeaningless there too. ``applied`` never carries a rejection reason.",
      "properties": {
        "dispatch_result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispatch Result"
        },
        "outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/RejectionReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification": {
          "additionalProperties": true,
          "title": "Verification",
          "type": "object"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "verified_at"
      ],
      "title": "ActionExecution",
      "type": "object"
    },
    "DecisionTrigger": {
      "description": "Why the agent issued this decision (FR-010).",
      "enum": [
        "proactive",
        "prompt_response"
      ],
      "title": "DecisionTrigger",
      "type": "string"
    },
    "ExecutionOutcome": {
      "enum": [
        "applied",
        "rejected",
        "partially_applied"
      ],
      "title": "ExecutionOutcome",
      "type": "string"
    },
    "RejectionReason": {
      "enum": [
        "not_in_catalog",
        "unavailable_to_human_now",
        "illegal_in_context",
        "out_of_parity_camera",
        "verification_failed"
      ],
      "title": "RejectionReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The single action the agent issued at one decision step (FR-012).\n\n``decision_step_id`` replaces any turn-level ``order_index`` from an\nearlier revision -- position within the turn comes entirely from the\nstep's own ``step_index``. ``prompt_type`` is required exactly when\n``trigger == prompt_response`` (FR-010), enforced below.",
  "properties": {
    "action_declaration_id": {
      "title": "Action Declaration Id",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "decision_step_id": {
      "title": "Decision Step Id",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/ActionExecution"
    },
    "is_end_turn": {
      "default": false,
      "title": "Is End Turn",
      "type": "boolean"
    },
    "model_call_id": {
      "title": "Model Call Id",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "prompt_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Type"
    },
    "reasoning": {
      "title": "Reasoning",
      "type": "string"
    },
    "trigger": {
      "$ref": "#/$defs/DecisionTrigger"
    }
  },
  "required": [
    "decision_id",
    "decision_step_id",
    "action_declaration_id",
    "reasoning",
    "trigger",
    "model_call_id",
    "execution"
  ],
  "schemaVersion": 1,
  "title": "Decision",
  "type": "object"
}
