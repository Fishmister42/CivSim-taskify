{
  "$defs": {
    "BuildAcceptance": {
      "additionalProperties": false,
      "description": "An operator-accepted deviation from a seed set's pinned game build (FR-002, R20).\n\nRecorded once on the seed set and referenced (via ``AcceptanceId``) by\nevery run that relied on it.",
      "properties": {
        "acceptance_id": {
          "title": "Acceptance Id",
          "type": "string"
        },
        "accepted_at": {
          "format": "date-time",
          "title": "Accepted At",
          "type": "string"
        },
        "accepted_by": {
          "title": "Accepted By",
          "type": "string"
        },
        "from_build": {
          "title": "From Build",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "to_build": {
          "title": "To Build",
          "type": "string"
        }
      },
      "required": [
        "acceptance_id",
        "from_build",
        "to_build",
        "accepted_by",
        "accepted_at",
        "reason"
      ],
      "title": "BuildAcceptance",
      "type": "object"
    },
    "ModRef": {
      "additionalProperties": false,
      "description": "A mod reference: id + version. Immutable by convention (mods are pinned, not mutated).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ModRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A named collection of map seeds sharing a civilization, ruleset, and game build (FR-031).\n\n``civilization``, ``leader``, ``ruleset``, and ``mod_set`` are immutable\nafter creation -- pydantic's per-field ``frozen=True`` rejects any\nattempt to reassign them once the model exists. Varying one of them\ndescribes a different, incomparable set of runs, not a variation within\nthis one. ``seeds`` may still be appended to (it is not frozen).",
  "properties": {
    "accepted_build_changes": {
      "items": {
        "$ref": "#/$defs/BuildAcceptance"
      },
      "title": "Accepted Build Changes",
      "type": "array"
    },
    "civilization": {
      "title": "Civilization",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "game_build": {
      "title": "Game Build",
      "type": "string"
    },
    "leader": {
      "title": "Leader",
      "type": "string"
    },
    "mod_set": {
      "items": {
        "$ref": "#/$defs/ModRef"
      },
      "title": "Mod Set",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "ruleset": {
      "title": "Ruleset",
      "type": "string"
    },
    "seed_set_id": {
      "title": "Seed Set Id",
      "type": "string"
    },
    "seeds": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    }
  },
  "required": [
    "seed_set_id",
    "name",
    "seeds",
    "civilization",
    "leader",
    "ruleset",
    "game_build",
    "created_at"
  ],
  "schemaVersion": 1,
  "title": "SeedSet",
  "type": "object"
}
